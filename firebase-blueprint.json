{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A retail product with pricing, variants, descriptions, images and inventory.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 200 },
        "slug": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 10000 },
        "shortDescription": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "maxLength": 100 },
        "subcategory": { "type": "string", "maxLength": 100 },
        "price": { "type": "number" },
        "compareAtPrice": { "type": "number" },
        "sku": { "type": "string", "maxLength": 100 },
        "images": {
          "type": "array",
          "description": "List of high-resolution product image URLs"
        },
        "stock": { "type": "number" },
        "status": {
          "type": "string",
          "enum": ["published", "draft", "archived"]
        },
        "featured": { "type": "boolean" },
        "bestseller": { "type": "boolean" },
        "newArrival": { "type": "boolean" },
        "tags": { "type": "array" },
        "specifications": { "type": "object" },
        "variants": { "type": "array" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "slug", "category", "price", "stock", "status"]
    },
    "Category": {
      "title": "Category",
      "description": "A store department or product category.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "image": { "type": "string" },
        "productCount": { "type": "number" }
      },
      "required": ["name", "slug"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer placed order with snapshot items, customer details, and fulfillment status.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string", "maxLength": 50 },
        "customerEmail": { "type": "string", "maxLength": 200 },
        "customerName": { "type": "string", "maxLength": 200 },
        "customerPhone": { "type": "string", "maxLength": 50 },
        "shippingAddress": { "type": "object" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "shipping": { "type": "number" },
        "discount": { "type": "number" },
        "discountCode": { "type": "string" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["pending", "confirmed", "processing", "shipped", "delivered", "cancelled"]
        },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["orderNumber", "customerEmail", "customerName", "items", "total", "status"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized administrator user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "enum": ["admin", "superadmin"] },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Product catalog documents"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Store categories"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Placed customer orders"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Admin users permissions table"
    }
  }
}
