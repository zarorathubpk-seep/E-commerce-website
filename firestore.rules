rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwnerAdmin() {
      return isSignedIn() && request.auth.token.email == 'mralexander461@gmail.com';
    }

    // Health check test doc
    match /test/{docId} {
      allow read: if true;
    }

    // Anyone can read products; only owner admin can create, update, or delete products and inventory
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isOwnerAdmin();
    }

    // Anyone can read categories; only owner admin can create, update, or delete
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isOwnerAdmin();
    }

    // Anyone can read departments; only owner admin can create, update, or delete
    match /departments/{departmentId} {
      allow read: if true;
      allow create, update, delete: if isOwnerAdmin();
    }

    // Customers can create an order but cannot read, update, or delete other people's orders.
    // Only the admin can read all orders and update order status.
    match /orders/{orderId} {
      allow create: if true;
      allow read: if isOwnerAdmin() || (isSignedIn() && resource.data.customerEmail == request.auth.token.email);
      allow update, delete: if isOwnerAdmin();
    }

    // Everything else is denied by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
